# Copy to .env.local for local dev, or set as a Vercel project env var.

# URL of the deployed backend (Render), no trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public Firebase Web configuration. Rebuild after changing these.
# Enable Google and Email/Password in Firebase and authorize this site's domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public Stripe publishable key; backend needs its corresponding secret/webhook.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional one-time startup support: absolute HTTPS merchant-hosted payment page.
# Set on the FRONTEND host (Vercel), without NEXT_PUBLIC_. Redeploy to apply.
# Leave empty to show an honest unavailable state. Never place a secret key here.
SUPPORT_PAYMENT_URL=
