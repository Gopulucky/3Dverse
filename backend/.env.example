# Copy to .env for local dev, or set these as environment variables in Render.

# "development" | "production" -- anything other than "development" is treated
# as production (enables the SECRET_KEY safety check and production adapters).
# MUST be set to "production" on any public deployment. Leaving it unset or at
# "development" serves /docs and the OpenAPI schema publicly and disables the
# SECRET_KEY safety check. Checkout always requires real provider confirmation.
ENVIRONMENT=development

# Generate a real value for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=supersecretkey-change-in-production

# Comma-separated list of allowed frontend origins (no trailing slashes).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://3dverse-tan.vercel.app

# --- Database (Supabase) ---
# Supabase gives you a full connection string like:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Split it into the fields below. Prefer the "connection pooling" host
# (port 6543, pgbouncer) for the web service, and the direct host (port 5432)
# for one-off migration runs.
POSTGRES_SERVER=localhost:5433
POSTGRES_USER=3dverse_user
POSTGRES_PASSWORD=3dverse_password
POSTGRES_DB=3dverse

# --- Redis (Render Redis add-on / Upstash) ---
# If set, this wins over REDIS_HOST/PORT/PASSWORD below. Render's Redis
# add-on and Upstash both hand you a single redis:// or rediss:// URL.
REDIS_URL=redis://localhost:6379/0

# --- File storage (S3) ---
# Required in production: Render's filesystem is ephemeral, so without these
# uploaded model files/images are lost on every redeploy.
# Object storage for uploaded models, media and generated previews.
# REQUIRED in any hosted deploy: without it files land on the container's own
# disk, which the Celery worker cannot see and which is wiped on every deploy.
# Works with any S3-compatible service -- for Supabase Storage set
# AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3 and use the
# S3 access key/secret from Project Settings > Storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_PUBLIC_BUCKET_NAME=
AWS_PUBLIC_BASE_URL=

# --- Firebase Auth only (PostgreSQL remains the marketplace database) ---
# Uncomment after creating the project; credentials stay on the server.
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/your-service-account.json
# Never set FIREBASE_AUTH_EMULATOR_HOST on a public deployment.

# --- Payment confirmation ---
# STRIPE_SECRET_KEY=sk_test_your-key
# STRIPE_WEBHOOK_SECRET=whsec_your-endpoint-secret
ALLOW_MOCK_PAYMENTS=false
# Operator-set standard delivery fee in INR; unset blocks physical checkout.
# CHECKOUT_SHIPPING_INR=your-actual-fee

# --- Shiprocket (production requires a real account and pickup location) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=

# --- Email / monitoring ---
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=3DVerse <no-reply@3dverse.local>
SENTRY_DSN=

# Compute embeddings in this process when no Celery worker is reachable.
# Off by default: the model is ~400MB resident and will OOM a small web dyno.
# Only turn this on for local development.
ENABLE_LOCAL_EMBEDDINGS=
